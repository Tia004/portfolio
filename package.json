{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "depcheck": "npx depcheck --ignores=@types/*,prisma --skip-missing=true || true",
    "check:icons": "node scripts/check-icons-sync.mjs",
    "deploy:setup-webhook": "curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook?url=${VERCEL_URL}/api/chat/webhook\" 2>&1 | python3 -m json.tool",
    "deploy:check-webhook": "curl \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getWebhookInfo\" 2>&1 | python3 -m json.tool",
    "webhook-local": "node scripts/setup-webhook-local.mjs"
  },
