# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
reference/

# local backup of original (non-converted) uploads — never commit
/backup-original-uploads
.freebuff

# local agent config + throwaway e2e scripts — never commit
.agents/
/e2e-chatbot.cjs

# local agent notes & handoffs — never commit
/NOTES-RESEND-EMAIL.txt
/HANDOFF*.md
*HANDOFF*
*handoff*

# SQLite local databases — never commit
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal
prisma/dev.db

prisma
!prisma/
!prisma/migrations/
!prisma/migrations/**GLOW-BLEED-CONFIG.txt
/GLOW-BLEED-CONFIG.txt


