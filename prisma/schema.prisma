// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authenticators Authenticator[]
}

model Authenticator {
  id                   String    @id @default(uuid())
  credentialID         String    @unique
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  nickname             String?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId String
  text      String
  sender    String
  timestamp BigInt

  @@index([sessionId, timestamp])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  service   String
  message   String
  status    String   @default("new") // "new" | "in_progress" | "contacted" | "closed"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model ChatSessionLead {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  category    String
  service     String?
  budget      String?
  userGoal    String?
  clientName  String?
  clientEmail String?
  recapJson   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model FaqItem {
  id          String   @id @default(uuid())
  questionIt  String
  questionEn  String?
  questionEs  String?
  answerIt    String
  answerEn    String?
  answerEs    String?
  category    String   @default("general")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientReview {
  id          String   @id @default(uuid())
  author      String
  role        String
  company     String?
  companyLogo String?
  showLogo    Boolean  @default(true)
  quoteIt     String
  quoteEn     String?
  quoteEs     String?
  rating      Int      @default(5)
  avatarUrl   String?
  order       Int      @default(0)
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("info") // "info" | "warn" | "error"
  source    String   // "resend" | "cal" | "auth" | "contact" | "api"
  message   String
  metadata  String?
  timestamp DateTime @default(now())

  @@index([level, timestamp])
}

model AvailabilitySetting {
  id        Int      @id
  isOnline  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Project {
  id              String   @id @default(uuid())
  title           String
  titleEn         String?
  titleEs         String?
  description     String
  descriptionEn   String?
  descriptionEs   String?
  longDescription String?
  thumbnail       String
  projectUrl      String?
  githubUrl       String?
  tags            String
  category        String   @default("Sviluppo")
  featured        Boolean  @default(false)
  order           Int      @default(0)
  gallery         String?  // JSON array string of image URLs
  pdfUrl          String?  // URL of attached PDF
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  type      String
  url       String
  sessionId String
  data      String?
  timestamp BigInt
  createdAt DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId, timestamp])
  @@index([timestamp])
}

model Quote {
  id            String    @id @default(uuid())
  quoteNumber   String    @unique
  date          String
  validity      String
  timeline      String
  clientName    String
  clientCompany String?
  clientEmail   String
  clientPhone   String?
  clientAddress String?
  clientVat     String?
  itemsJson     String
  discount      Int       @default(0)
  taxRegime     String    @default("forfettario")
  paymentTerms  String
  iban          String
  notes         String?
  subtotal      Float
  total         Float
  status        String    @default("draft") // "draft" | "sent" | "accepted" | "rejected"
  signatureData String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@index([clientEmail])
}

/// A newsletter subscriber collected through the public double opt-in form.
/// The record is the proof of consent: `consentText` stores the exact wording
/// the visitor accepted, and `status` only becomes "confirmed" after they click
/// the confirmation link that arrives by email.
model NewsletterSubscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  /// "pending" (waiting for the email confirmation) | "confirmed" | "unsubscribed"
  status           String    @default("pending")
  /// Locale of the signup, so the confirmation email goes out in their language.
  locale           String    @default("it")
  /// Where the signup came from ("website", "dashboard", …).
  source           String    @default("website")
  /// The consent wording shown next to the checkbox, stored verbatim.
  consentText      String?
  consentAt        DateTime?
  /// Cleared once used, so a leaked confirmation link cannot be replayed.
  confirmToken     String?   @unique
  /// Survives confirmation: it is the opt-out link inside every campaign.
  unsubscribeToken String    @unique
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  /// SHA-256 of the address with the server secret — never the raw IP.
  ipHash           String?
  userAgent        String?
  /// Throttles repeated confirmation emails to the same address.
  lastEmailAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
}

model NewsletterCampaign {
  id             String    @id @default(uuid())
  subject        String
  previewText    String?
  bodyContent    String
  recipients     String    @default("all_contacts") // 'all_contacts' | 'all_leads' | 'all_audience' | 'subscribers' | comma separated emails
  recipientCount Int       @default(0)
  status         String    @default("draft") // "draft" | "scheduled" | "sent" | "failed"
  scheduledFor   DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

model CustomEmailTemplate {
  id        String   @id @default(uuid())
  name      String
  icon      String   @default("✉️")
  badge     String   @default("Tia Designs")
  title     String
  subject   String
  body      String
  ctaText   String?
  ctaUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SentEmailLog {
  id        String   @id @default(uuid())
  email     String
  name      String?
  company   String?
  subject   String?
  source    String   @default("auto_sender") // "auto_sender" | "single_send" | "aruba_webmail" | "seed"
  sentAt    DateTime @default(now())

  @@index([email])
  @@index([sentAt])
}

model ClientReferral {
  id                    String            @id @default(uuid())
  code                  String            @unique
  clientName            String
  clientEmail           String
  clientCompany         String?
  discountPercent       Int               @default(20)
  visitsCount           Int               @default(0)
  leadsCount            Int               @default(0)
  conversionsCount      Int               @default(0)
  totalRewardAttributed Float             @default(0)
  status                String            @default("active") // "active" | "inactive" | "rewarded"
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  leads                 ReferralLeadLog[]

  @@index([code])
  @@index([clientEmail])
  @@index([status])
}

model ReferralLeadLog {
  id               String          @id @default(uuid())
  referralId       String
  referralCode     String
  leadName         String
  leadEmail        String
  service          String?
  source           String          @default("contact") // "contact" | "ai_quote" | "quote_accepted"
  dealValue        Float?
  attributedReward Float?
  notes            String?
  createdAt        DateTime        @default(now())
  referral         ClientReferral  @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([referralCode])
  @@index([createdAt])
}


